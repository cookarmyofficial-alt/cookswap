# Defaults run the EVM UI and backend with no private data or external catalogs.
HOST=127.0.0.1
PORT=5012
DEFAULT_NETWORK=cookchain
COOK_RPC=https://rpc.cookscan.net/evm
EXPECTED_GENESIS=0xcf5b9cb3565f307806ee9f9e7652e405827b20655621ab284c0e80afea85a397
APP_ORIGIN=http://localhost:5012
# Set your own wallet to enable admin access (HTTPS required for admin cookies).
ADMIN_WALLET=
SWAP_ADMIN_DATA=./data/admin
DB_HOST=127.0.0.1
DEX_DB_PORT=13306
USER_DB_PORT=3306
# Optional service origins. Empty disables these integrations.
COOKDEX_ORIGIN=
CHART_ORIGIN=
BRIDGE_ORIGIN=
